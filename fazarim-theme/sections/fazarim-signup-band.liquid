{% comment %}
  Pre-footer sign-up band, modelled on drunkelephant.com (SRS §1.6 reference).

  Measured off their live footer at a 1440 viewport on 2026-08-05:
    .footer-section2   flex, space-between, 1400 x 350
    logo block         350 x 350, border-radius 50%, tinted circle
    newsletter         700 wide, inner panel 660 x 350, radius 5px
    promo image        350 x 350, caption chip lower-left

  So 25 / 50 / 25. Their proportions, our palette and type — the panel takes the
  brand mauve tint rather than their pale blue, and copy is ours.

  The email field is Shopify's `customer` form, the same one Dawn's newsletter
  section posts through, so subscribers land in the normal customer list.
{% endcomment %}

{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}

<div class="fz-signup page-width section-{{ section.id }}-padding">
  <div class="fz-signup__grid">
    {%- if section.settings.show_logo -%}
      <div class="fz-signup__mark">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 700
            | image_tag: loading: 'lazy', class: 'fz-signup__mark-img', alt: shop.name
          }}
        {%- elsif settings.logo != blank -%}
          {{
            settings.logo
            | image_url: width: 700
            | image_tag: loading: 'lazy', class: 'fz-signup__mark-img', alt: shop.name
          }}
        {%- else -%}
          <span class="fz-signup__mark-text">{{ shop.name }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="fz-signup__panel">
      {%- if section.settings.heading != blank -%}
        <p class="fz-signup__heading">{{ section.settings.heading }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'fz-signup__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="fz-signup__field">
          <label class="visually-hidden" for="FzSignup-{{ section.id }}">
            {{ 'newsletter.label' | t }}
          </label>
          <input
            id="FzSignup-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            class="fz-signup__input"
            placeholder="{{ section.settings.placeholder }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            aria-required="true"
            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="FzSignup-error-{{ section.id }}"
            {% elsif form.posted_successfully? %}
              aria-describedby="FzSignup-success-{{ section.id }}"
            {% endif %}
            required
          >
          <button type="submit" class="fz-signup__submit" name="commit">
            {{ section.settings.button_label | escape }}
          </button>
        </div>

        {%- if form.errors -%}
          <small class="fz-signup__message fz-signup__message--error" id="FzSignup-error-{{ section.id }}">
            {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
          </small>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <p class="fz-signup__message" id="FzSignup-success-{{ section.id }}" tabindex="-1">
            {{ 'newsletter.success' | t }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>

    {%- if section.settings.image != blank -%}
      <div class="fz-signup__promo">
        {{
          section.settings.image
          | image_url: width: 700
          | image_tag: loading: 'lazy', class: 'fz-signup__promo-img', widths: '350, 700'
        }}
        {%- if section.settings.image_caption != blank -%}
          <span class="fz-signup__caption">{{ section.settings.image_caption }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Sign-up band",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Brand mark"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show brand mark",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to use the theme logo."
    },
    {
      "type": "header",
      "content": "Sign-up"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sign up and get skincare notes worth reading"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Field placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Product image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Caption"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Sign-up band"
    }
  ]
}
{% endschema %}
